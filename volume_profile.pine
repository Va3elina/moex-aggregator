//@version=6
indicator("Volume Profile", "VolProf", overlay=true, max_boxes_count=500, max_lines_count=10)

// ============================================================================
// SETTINGS / НАСТРОЙКИ
// ============================================================================
lookback   = input.int(200, "Баров назад", minval=20, maxval=500, group="Профиль")
rows       = input.int(50, "Количество уровней", minval=10, maxval=100, group="Профиль")
width_mult = input.int(80, "Ширина баров", minval=10, maxval=300, group="Профиль")
va_pct     = input.float(70, "Value Area %", minval=50, maxval=90, step=5, group="Профиль")

col_up     = input.color(color.new(#26a69a, 40), "Покупки", group="Цвета")
col_down   = input.color(color.new(#ef5350, 40), "Продажи", group="Цвета")
col_poc    = input.color(color.new(color.yellow, 0), "POC", group="Цвета")
col_va     = input.color(color.new(color.orange, 70), "Value Area", group="Цвета")

// ============================================================================
// CALCULATION / РАСЧЕТ
// ============================================================================
var float[] vol_up   = array.new_float(rows, 0.0)
var float[] vol_down = array.new_float(rows, 0.0)
var box[]   boxes    = array.new_box()
var line    poc_line = na
var line    va_hi_line = na
var line    va_lo_line = na

// Вызов на каждом баре (обязательно для Pine Script)
float hi = ta.highest(high, lookback)
float lo = ta.lowest(low, lookback)

if barstate.islast
    // Очистка
    while array.size(boxes) > 0
        box.delete(array.pop(boxes))
    line.delete(poc_line)
    line.delete(va_hi_line)
    line.delete(va_lo_line)

    // Диапазон цен
    float step = (hi - lo) / rows

    // Обнуление
    for i = 0 to rows - 1
        array.set(vol_up, i, 0.0)
        array.set(vol_down, i, 0.0)

    // Распределение объёма по уровням
    for b = 0 to lookback - 1
        float c  = close[b]
        float o  = open[b]
        float v  = volume[b]
        int idx  = math.min(math.floor((c - lo) / step), rows - 1)
        if idx >= 0 and idx < rows
            if c >= o
                array.set(vol_up, idx, array.get(vol_up, idx) + v)
            else
                array.set(vol_down, idx, array.get(vol_down, idx) + v)

    // Общий объём на уровень + максимум (POC)
    float max_vol = 0.0
    int   poc_idx = 0
    float total_vol = 0.0

    for i = 0 to rows - 1
        float tv = array.get(vol_up, i) + array.get(vol_down, i)
        total_vol := total_vol + tv
        if tv > max_vol
            max_vol := tv
            poc_idx := i

    // Value Area
    float va_vol = array.get(vol_up, poc_idx) + array.get(vol_down, poc_idx)
    float va_target = total_vol * (va_pct / 100)
    int va_lo_idx = poc_idx
    int va_hi_idx = poc_idx

    for _i = 0 to rows - 1
        if va_vol >= va_target
            break
        float up_vol = va_hi_idx < rows - 1 ? array.get(vol_up, va_hi_idx + 1) + array.get(vol_down, va_hi_idx + 1) : 0.0
        float dn_vol = va_lo_idx > 0 ? array.get(vol_up, va_lo_idx - 1) + array.get(vol_down, va_lo_idx - 1) : 0.0
        if up_vol >= dn_vol and va_hi_idx < rows - 1
            va_hi_idx := va_hi_idx + 1
            va_vol := va_vol + up_vol
        else if va_lo_idx > 0
            va_lo_idx := va_lo_idx - 1
            va_vol := va_vol + dn_vol

    // Рисуем бары
    int bar_right = bar_index
    for i = 0 to rows - 1
        float price_lo = lo + i * step
        float price_hi = price_lo + step
        float vu = array.get(vol_up, i)
        float vd = array.get(vol_down, i)
        float tv = vu + vd
        if tv > 0
            int bar_w = math.round(tv / max_vol * width_mult)
            // Покупки
            if vu > 0
                int w_up = math.max(math.round(vu / max_vol * width_mult), 1)
                array.push(boxes, box.new(bar_right, price_hi, bar_right + w_up, price_lo, bgcolor=col_up, border_color=color.new(color.white, 90), border_width=0))
            // Продажи
            if vd > 0
                int w_dn = math.max(math.round(vd / max_vol * width_mult), 1)
                int offset = math.round(vu / max_vol * width_mult)
                array.push(boxes, box.new(bar_right + offset, price_hi, bar_right + offset + w_dn, price_lo, bgcolor=col_down, border_color=color.new(color.white, 90), border_width=0))

    // POC линия
    float poc_price = lo + poc_idx * step + step / 2
    poc_line := line.new(bar_index - lookback, poc_price, bar_index + width_mult, poc_price, color=col_poc, width=2, style=line.style_solid)

    // Value Area линии
    float va_hi_price = lo + (va_hi_idx + 1) * step
    float va_lo_price = lo + va_lo_idx * step
    va_hi_line := line.new(bar_index - lookback, va_hi_price, bar_index + width_mult, va_hi_price, color=col_va, width=1, style=line.style_dashed)
    va_lo_line := line.new(bar_index - lookback, va_lo_price, bar_index + width_mult, va_lo_price, color=col_va, width=1, style=line.style_dashed)

// ============================================================================
// INFO TABLE
// ============================================================================
var table info_table = table.new(position.top_right, 2, 3, bgcolor=color.new(color.white, 20), border_width=1)

if barstate.islast
    float stp = (hi - lo) / rows
    int poc_i = math.max(math.min(math.floor((close - lo) / stp), rows - 1), 0)
    float poc_p = lo + poc_i * stp + stp / 2

    table.cell(info_table, 0, 0, "POC:", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 0, str.tostring(poc_p, format.mintick), text_color=col_poc, text_size=size.small)
    table.cell(info_table, 0, 1, "Баров:", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(lookback), text_color=color.white, text_size=size.small)
    table.cell(info_table, 0, 2, "Value Area:", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 2, str.tostring(va_pct) + "%", text_color=col_va, text_size=size.small)
