# Ротация nginx-логов Фрейма.
#
# ⚠️ ЭТОТ ФАЙЛ НЕ ПРИМЕНЯЕТСЯ САМ. Он source of truth в репозитории; на сервере
# живёт копия в /etc/logrotate.d/frame-nginx. CI (deploy.yml) nginx и хостовый
# конфиг не трогает, поэтому после правки — скопировать вручную:
#
#   scp nginx/logrotate/frame-nginx root@103.88.243.232:/etc/logrotate.d/frame-nginx
#   ssh ... 'logrotate -d /etc/logrotate.d/frame-nginx'   # dry-run, проверить
#
# Явные пути вместо *.log: bi_access.log нужен со своим сроком, а два правила
# с пересекающимся глобом logrotate отвергает как duplicate log entry.

# ─── Операционные логи: 14 дней ──────────────────────────────────────
# Нужны для разбора инцидентов и fail2ban (читает error.log). Содержат сырой
# IP — дольше двух недель держать незачем.
/opt/frame/nginx/logs/access.log
/opt/frame/nginx/logs/error.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

# ─── Технические данные по использованию Биржевой информации: 3 года ──
# Договор ИТО с ПАО Московская Биржа, п.4.6.1: хранить «в течение разумного
# срока, но не менее 3 (трёх) лет с момента получения». Аудируемый период по
# Порядку проведения информационного аудита тоже ограничен тремя годами
# (Приложение №1, п.2.3), так что 1100 дней покрывают максимальную глубину
# проверки с запасом.
#
# IP в этом логе обезличен на уровне формата (см. conf.d/00-bi-logging.conf),
# поэтому длительное хранение не создаёт массива сырых адресов.
# Объём: подмножество запросов (/api/ + /embed/), в сжатом виде порядка
# сотен КБ в сутки → ~0.2-0.5 ГБ за три года при 77 ГБ диска.
/opt/frame/nginx/logs/bi_access.log {
    daily
    rotate 1100
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
