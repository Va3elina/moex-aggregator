var array<int>   ds = array.new<int>()
var array<float> vv = array.new<float>()
if barstate.isfirst
    for row in str.split(DATA, ";")
        f = str.split(row, ",")
        array.push(ds, int(str.tonumber(array.get(f,0))))
        array.push(vv, str.tonumber(array.get(f,1)))

cur = year(time)*10000 + month(time)*100 + dayofmonth(time)
idx = -1
lo = 0
hi = array.size(ds) - 1
while lo <= hi
    mid = int((lo + hi) / 2)
    if array.get(ds, mid) <= cur
        idx := mid
        lo := mid + 1
    else
        hi := mid - 1

mr1 = idx >= 0 ? array.get(vv, idx) : na
floorLvl = 33   // исторический «пол» ставки

// Реальное повышение: 3 дня назад ставка выросла и удержалась (а не отскочила = праздничный блип)
realHike = not na(mr1) and mr1[3] > mr1[4] and mr1 >= mr1[3]
realCut  = not na(mr1) and mr1[3] < mr1[4] and mr1 <= mr1[3]

plot(mr1, "ставка риска mr1, %", color=color.new(color.red,0), linewidth=2, style=plot.style_stepline)
hline(floorLvl, "пол", color=color.new(color.gray,50), linestyle=hline.style_dotted)
bgcolor(mr1 > floorLvl*1.5 ? color.new(color.red,90) : na)
plotshape(realHike, "НКЦ поднял ставку (стресс)", shape.triangleup,   location.bottom, color.new(color.red,0),   size=size.small, text="стресс")
plotshape(realCut,  "НКЦ снизил ставку (разрядка)", shape.triangledown, location.top,    color.new(color.green,0), size=size.tiny)
