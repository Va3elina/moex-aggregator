//@version=6
indicator("НКЦ Fear · ставки риска mr1/mr2/mr3 (Сбер/Нефть/Доллар)", overlay=false)

// Ставки рыночного риска НКЦ/MOEX (% от цены), вписаны вручную из дневной выгрузки.
// mr1 — базовый уровень (основа ГО), mr2/mr3 — более широкие коридоры.
// Ступенчатый ряд: значение держится до следующей даты-перелома.

inst = input.string("Сбербанк", "Инструмент", options=["Сбербанк","Нефть Brent","Доллар (Si)"])

