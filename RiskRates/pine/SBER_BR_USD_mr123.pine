[s1,s2,s3] = sber()
[o1,o2,o3] = oil()
[u1,u2,u3] = usd()
m1 = inst=="Сбербанк" ? s1 : inst=="Нефть Brent" ? o1 : u1
m2 = inst=="Сбербанк" ? s2 : inst=="Нефть Brent" ? o2 : u2
m3 = inst=="Сбербанк" ? s3 : inst=="Нефть Brent" ? o3 : u3

greedLvl = inst=="Сбербанк" ? 19.2 : inst=="Нефть Brent" ? 16.0 : 7.8
fearLvl  = inst=="Сбербанк" ? 29.6 : inst=="Нефть Brent" ? 28.0 : 11.4

plot(m3, "mr3 (широкий)", color=color.new(color.yellow,30), linewidth=1, style=plot.style_stepline)
plot(m2, "mr2", color=color.new(color.orange,10), linewidth=1, style=plot.style_stepline)
plot(m1, "mr1 (база/страх)", color=color.new(color.red,0), linewidth=2, style=plot.style_stepline)
hline(0, "", color=color.new(color.gray,100))
p1=plot(greedLvl, "Жадность", color=color.new(color.green,50), linestyle=hline.style_dashed)
p2=plot(fearLvl, "Страх", color=color.new(color.red,50), linestyle=hline.style_dashed)
bgcolor(m1>=fearLvl ? color.new(color.red,88) : m1<=greedLvl ? color.new(color.green,90) : na)

cut  = m1 < m1[1]
hike = m1 > m1[1]
plotshape(cut and m1[1]>=fearLvl, "Разрядка", shape.triangleup, location.bottom, color.new(color.green,0), size=size.tiny)
plotshape(hike and m1[1]<=greedLvl,"Рост риска", shape.triangledown, location.top, color.new(color.red,0), size=size.tiny)
