var array<int>   ds = array.new<int>()
var array<float> v1 = array.new<float>()
var array<float> v2 = array.new<float>()
var array<float> v3 = array.new<float>()
if barstate.isfirst
    for row in str.split(DATA, ";")
        f = str.split(row, ",")
        array.push(ds, int(str.tonumber(array.get(f,0))))
        array.push(v1, str.tonumber(array.get(f,1)))
        array.push(v2, str.tonumber(array.get(f,2)))
        array.push(v3, str.tonumber(array.get(f,3)))

cur = year(time)*10000 + month(time)*100 + dayofmonth(time)
idx = -1
lo = 0
hi = array.size(ds) - 1
while lo <= hi
    mid = int((lo + hi) / 2)
    if array.get(ds, mid) <= cur
        idx := mid
        lo := mid + 1
    else
        hi := mid - 1

mr1 = idx >= 0 ? array.get(v1, idx) : na
mr2 = idx >= 0 ? array.get(v2, idx) : na
mr3 = idx >= 0 ? array.get(v3, idx) : na

plot(mr3, "mr3", color=color.new(color.yellow,30), style=plot.style_stepline)
plot(mr2, "mr2", color=color.new(color.orange,10), style=plot.style_stepline)
plot(mr1, "mr1", color=color.new(color.red,0), linewidth=2, style=plot.style_stepline)
