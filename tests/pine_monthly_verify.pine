// ============================================================
// PineScript: Monthly Seasonality Verification for SBER
// Сравнение с данными: таймфрейм.рф
//
// Применить к: MOEX:SBER, дневной ТФ
// Метод: avg daily close-to-close return grouped by month
// Период: последние 30 лет (iterations=30)
// ============================================================
//@version=5
indicator("Monthly Seasonality SBER (30y verify)", overlay=false)

years_back = input.int(19, "Лет назад", minval=1, maxval=30, tooltip="SBER данные с 2007 = ~19 лет")

// Raw close без дивидендной коррекции TV
[raw_close, raw_close_prev] = request.security(syminfo.tickerid, "D", [close, close[1]], adjustment=adjustment.none)

// Close-to-close return (%) — без adjusted
daily_return = (raw_close - raw_close_prev) / raw_close_prev * 100

lookback = years_back * 252  // ~252 торговых дней в году

// Суммы по месяцам
var float[] sum_m = array.new_float(12, 0.0)
var int[] cnt_m = array.new_int(12, 0)

if barstate.islast
    for j = 0 to 11
        array.set(sum_m, j, 0.0)
        array.set(cnt_m, j, 0)

    for i = 0 to lookback - 1
        if i + 1 < bar_index
            ret = (raw_close[i] - raw_close[i + 1]) / raw_close[i + 1] * 100
            m = month[i] - 1  // 0-based index
            if m >= 0 and m < 12
                array.set(sum_m, m, array.get(sum_m, m) + ret)
                array.set(cnt_m, m, array.get(cnt_m, m) + 1)

// ============ НАШИ ДАННЫЕ (таймфрейм.рф, 30 iter = all available ~19 years) ============
var float[] our = array.from(
     +0.0844,  // Янв
     -0.1385,  // Фев
     +0.1236,  // Мар
     +0.1439,  // Апр
     +0.1512,  // Май
     -0.0158,  // Июн
     +0.0816,  // Июл
     -0.1008,  // Авг
     +0.0614,  // Сен
     +0.0996,  // Окт
     +0.1549,  // Ноя
     +0.0493   // Дек
     )

var string[] month_names = array.from("Янв","Фев","Мар","Апр","Май","Июн","Июл","Авг","Сен","Окт","Ноя","Дек")

// Таблица
var table t = table.new(position.top_right, 4, 14, bgcolor=color.new(color.black, 70))

if barstate.islast
    table.cell(t, 0, 0, "Месяц", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "TV", text_color=color.yellow, text_size=size.small)
    table.cell(t, 2, 0, "Наш", text_color=color.lime, text_size=size.small)
    table.cell(t, 3, 0, "Diff", text_color=color.aqua, text_size=size.small)

    for j = 0 to 11
        c = array.get(cnt_m, j)
        avg_tv = c > 0 ? array.get(sum_m, j) / c : 0.0
        avg_our = array.get(our, j)
        diff = avg_tv - avg_our

        mn = array.get(month_names, j)
        table.cell(t, 0, j + 1, mn + " (n=" + str.tostring(c) + ")", text_color=color.white, text_size=size.small)
        table.cell(t, 1, j + 1, str.tostring(avg_tv, "#.####") + "%", text_color=color.yellow, text_size=size.small)
        table.cell(t, 2, j + 1, str.tostring(avg_our, "#.####") + "%", text_color=color.lime, text_size=size.small)
        table.cell(t, 3, j + 1, str.tostring(diff, "#.####"), text_color=math.abs(diff) < 0.02 ? color.lime : color.red, text_size=size.small)

    table.cell(t, 0, 13, "< 0.02 = OK", text_color=color.gray, text_size=size.tiny)

// График
plot(daily_return, "Daily Return %", color=daily_return >= 0 ? color.green : color.red, style=plot.style_histogram)
hline(0, "Zero", color=color.gray)
