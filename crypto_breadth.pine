//@version=6
strategy("Crypto Breadth Lab", "CrLab%", overlay=false, max_bars_back=500, pyramiding=2, default_qty_type=strategy.percent_of_equity, default_qty_value=50)

// ============================================================================
// 1. BREADTH — ЧТО СЧИТАЕМ
// ============================================================================
breadth_ma_type = input.string("EMA", "Breadth: тип MA", options=["EMA", "SMA", "WMA", "VWMA", "RMA"], group="1. Breadth")
breadth_ma_len  = input.int(200, "Breadth: период MA", minval=1, maxval=500, group="1. Breadth")
breadth_tf      = input.timeframe("D", "Breadth: таймфрейм расчёта", group="1. Breadth")

// ============================================================================
// 2. ТРЕНД — КАК ОПРЕДЕЛЯЕМ
// ============================================================================
trend_enabled   = input.bool(true, "Использовать тренд-фильтр", group="2. Тренд")
trend_ma_type   = input.string("EMA", "Тренд: тип MA", options=["EMA", "SMA", "WMA", "VWMA", "RMA"], group="2. Тренд")
trend_ma_len    = input.int(200, "Тренд: период MA", minval=1, maxval=500, group="2. Тренд")
trend_tf        = input.timeframe("W", "Тренд: таймфрейм", group="2. Тренд")
trend_src       = input.string("Close", "Тренд: источник", options=["Close", "HL2", "HLC3", "OHLC4"], group="2. Тренд")

// ============================================================================
// 3. МЕТОД ВХОДА — ФИКСИРОВАННЫЙ ИЛИ ДИНАМИЧЕСКИЙ
// ============================================================================
entry_method = input.string("Фиксированный", "Метод входа", options=["Фиксированный", "Z-Score", "BB (Bollinger)", "Percentile", "Все"], group="3. Вход")

// --- Фиксированный ---
fix_entry_level     = input.int(14, "  Фикс: breadth ≤ %", minval=1, maxval=100, group="3. Вход")
fix_entry_ema       = input.float(0.75, "  Фикс: EMA200 + breadth ≤ %", minval=0.1, maxval=100, step=0.25, group="3. Вход")

// --- Z-Score ---
zscore_lookback     = input.int(50, "  Z: lookback", minval=10, maxval=200, group="3. Вход")
zscore_entry_lvl    = input.float(-2.0, "  Z: вход Z ≤", minval=-4.0, maxval=0.0, step=0.25, group="3. Вход")

// --- Bollinger Bands на breadth ---
bb_len              = input.int(20, "  BB: период", minval=5, maxval=100, group="3. Вход")
bb_mult             = input.float(2.0, "  BB: множитель σ", minval=0.5, maxval=4.0, step=0.25, group="3. Вход")

// --- Percentile ---
pctl_lookback       = input.int(100, "  Pctl: lookback", minval=20, maxval=500, group="3. Вход")
pctl_entry_lvl      = input.int(5, "  Pctl: вход ≤ %", minval=1, maxval=30, group="3. Вход")

// ============================================================================
// 4. МЕТОД ВЫХОДА
// ============================================================================
exit_method = input.string("Фиксированный", "Метод выхода", options=["Фиксированный", "Z-Score", "BB (Bollinger)", "Percentile", "RSI", "RSI + BB", "Все"], group="4. Выход")

// --- Фиксированный ---
fix_exit_level      = input.int(60, "  Фикс: breadth ≥ %", minval=1, maxval=100, group="4. Выход")

// --- Z-Score ---
zscore_exit_lvl     = input.float(2.0, "  Z: выход Z ≥", minval=0.0, maxval=4.0, step=0.25, group="4. Выход")

// --- BB ---
// (использует те же bb_len, bb_mult)

// --- Percentile ---
pctl_exit_lvl       = input.int(95, "  Pctl: выход ≥ %", minval=70, maxval=99, group="4. Выход")

// ============================================================================
// 5. RSI — НАСТРОЙКИ
// ============================================================================
rsi_enabled     = input.bool(true, "RSI включён", group="5. RSI")
rsi_source      = input.string("Цена", "RSI: источник", options=["Цена", "Breadth"], tooltip="RSI от цены графика или от значения breadth", group="5. RSI")
rsi_len         = input.int(14, "RSI: период", minval=2, maxval=50, group="5. RSI")
rsi_ma_type     = input.string("SMA", "RSI: MA тип", options=["SMA", "EMA", "WMA", "RMA"], group="5. RSI")
rsi_ma_len      = input.int(14, "RSI: MA период", minval=2, maxval=50, group="5. RSI")
rsi_tf          = input.timeframe("W", "RSI: таймфрейм", group="5. RSI")
rsi_exit_level  = input.int(70, "RSI: фикс выход <", minval=30, maxval=90, group="5. RSI")

// --- BB на RSI ---
rsi_bb_enabled  = input.bool(false, "RSI: BB динамические уровни", group="5. RSI")
rsi_bb_len      = input.int(20, "RSI: BB период", minval=5, maxval=100, group="5. RSI")
rsi_bb_mult     = input.float(2.0, "RSI: BB множитель σ", minval=0.5, maxval=4.0, step=0.25, group="5. RSI")

// ============================================================================
// 6. MA НА ИНДИКАТОРЕ (визуализация)
// ============================================================================
show_histogram = input.bool(true, "Показать гистограмму", group="6. Визуализация")
show_ma1  = input.bool(true,  "MA 1", group="6. Визуализация")
ma1_type  = input.string("SMA", "  MA1 Тип", options=["SMA", "EMA", "WMA", "RMA"], group="6. Визуализация")
ma1_len   = input.int(10, "  MA1 Длина", minval=1, maxval=200, group="6. Визуализация")
ma1_color = input.color(color.yellow, "  MA1 Цвет", group="6. Визуализация")

show_ma2  = input.bool(false, "MA 2", group="6. Визуализация")
ma2_type  = input.string("SMA", "  MA2 Тип", options=["SMA", "EMA", "WMA", "RMA"], group="6. Визуализация")
ma2_len   = input.int(30, "  MA2 Длина", minval=1, maxval=200, group="6. Визуализация")
ma2_color = input.color(color.white, "  MA2 Цвет", group="6. Визуализация")

show_bb_overlay = input.bool(false, "Показать BB на breadth", group="6. Визуализация")
show_zscore_bg  = input.bool(true, "Показать Z-Score фон", group="6. Визуализация")

// ============================================================================
// TOP 30 CRYPTO
// ============================================================================
tickers = array.from(
     "BINANCE:BTCUSDT",   "BINANCE:ETHUSDT",    "BINANCE:XRPUSDT",
     "BINANCE:BNBUSDT",   "BINANCE:SOLUSDT",    "BINANCE:DOGEUSDT",
     "BINANCE:ADAUSDT",   "BINANCE:TRXUSDT",    "BINANCE:AVAXUSDT",
     "BINANCE:LINKUSDT",  "BINANCE:TONUSDT",    "BINANCE:SHIBUSDT",
     "BINANCE:XLMUSDT",   "BINANCE:DOTUSDT",    "BINANCE:SUIUSDT",
     "BINANCE:HBARUSDT",  "BINANCE:BCHUSDT",    "BINANCE:LTCUSDT",
     "BINANCE:UNIUSDT",   "BINANCE:NEARUSDT",   "BINANCE:APTUSDT",
     "BINANCE:PEPEUSDT",  "BINANCE:ICPUSDT",    "BINANCE:POLUSDT",
     "BINANCE:ETCUSDT",   "BINANCE:RENDERUSDT", "BINANCE:FETUSDT",
     "BINANCE:ATOMUSDT",  "BINANCE:FILUSDT",    "BINANCE:ARBUSDT")

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================
f_ma(src, len, typ) =>
    switch typ
        "EMA"  => ta.ema(src, len)
        "SMA"  => ta.sma(src, len)
        "WMA"  => ta.wma(src, len)
        "VWMA" => ta.vwma(src, len)
        "RMA"  => ta.rma(src, len)
        => ta.sma(src, len)

f_src(typ) =>
    switch typ
        "Close" => close
        "HL2"   => hl2
        "HLC3"  => hlc3
        "OHLC4" => ohlc4
        => close

f_percentile_rank(src, lookback) =>
    count = 0
    for i = 1 to lookback
        if src[i] < src
            count := count + 1
    (count / lookback) * 100

// ============================================================================
// BREADTH CALCULATION
// ============================================================================
f_getCondition(symbol, ma_period, ma_typ) =>
    switch ma_typ
        "EMA" =>
            [price, ma_val] = request.security(symbol, breadth_tf, [close, ta.ema(close, ma_period)], barmerge.gaps_on)
            price > ma_val and not na(price) and not na(ma_val)
        "SMA" =>
            [price, ma_val] = request.security(symbol, breadth_tf, [close, ta.sma(close, ma_period)], barmerge.gaps_on)
            price > ma_val and not na(price) and not na(ma_val)
        "WMA" =>
            [price, ma_val] = request.security(symbol, breadth_tf, [close, ta.wma(close, ma_period)], barmerge.gaps_on)
            price > ma_val and not na(price) and not na(ma_val)
        "RMA" =>
            [price, ma_val] = request.security(symbol, breadth_tf, [close, ta.rma(close, ma_period)], barmerge.gaps_on)
            price > ma_val and not na(price) and not na(ma_val)
        =>
            [price, ma_val] = request.security(symbol, breadth_tf, [close, ta.ema(close, ma_period)], barmerge.gaps_on)
            price > ma_val and not na(price) and not na(ma_val)

countAbove = 0
for i = 0 to array.size(tickers) - 1
    if f_getCondition(array.get(tickers, i), breadth_ma_len, breadth_ma_type)
        countAbove := countAbove + 1

countTotal   = array.size(tickers)
percentAbove = (countAbove / countTotal) * 100

// ============================================================================
// TREND FILTER
// ============================================================================
trend_source = f_src(trend_src)
[chartClose_trend, chartMA_trend] = request.security(syminfo.tickerid, trend_tf, [close, f_ma(trend_source, trend_ma_len, trend_ma_type)], barmerge.gaps_on)
priceBelowTrendMA = chartClose_trend < chartMA_trend and not na(chartClose_trend) and not na(chartMA_trend)
priceAboveTrendMA = chartClose_trend > chartMA_trend and not na(chartClose_trend) and not na(chartMA_trend)

// ============================================================================
// Z-SCORE на breadth
// ============================================================================
breadth_mean  = ta.sma(percentAbove, zscore_lookback)
breadth_stdev = ta.stdev(percentAbove, zscore_lookback)
zscore        = breadth_stdev != 0 ? (percentAbove - breadth_mean) / breadth_stdev : 0

// ============================================================================
// BOLLINGER BANDS на breadth
// ============================================================================
bb_basis = ta.sma(percentAbove, bb_len)
bb_dev   = ta.stdev(percentAbove, bb_len) * bb_mult
bb_upper = bb_basis + bb_dev
bb_lower = bb_basis - bb_dev

// ============================================================================
// PERCENTILE RANK на breadth
// ============================================================================
pctl_rank = f_percentile_rank(percentAbove, pctl_lookback)

// ============================================================================
// RSI (на выбранном источнике и таймфрейме)
// ============================================================================
rsi_raw_price = ta.rsi(close, rsi_len)
rsi_raw_breadth = ta.rsi(percentAbove, rsi_len)
rsi_val = rsi_source == "Breadth" ? rsi_raw_breadth : rsi_raw_price

// RSI MA
rsi_ma = f_ma(rsi_val, rsi_ma_len, rsi_ma_type)

// RSI с выбранного ТФ
[rsi_tf_val, rsi_tf_ma] = request.security(syminfo.tickerid, rsi_tf, [ta.rsi(close, rsi_len), f_ma(ta.rsi(close, rsi_len), rsi_ma_len, rsi_ma_type)])
rsi_active    = rsi_source == "Breadth" ? rsi_val : rsi_tf_val
rsi_ma_active = rsi_source == "Breadth" ? rsi_ma  : rsi_tf_ma

// BB на RSI
rsi_bb_basis = ta.sma(rsi_active, rsi_bb_len)
rsi_bb_dev   = ta.stdev(rsi_active, rsi_bb_len) * rsi_bb_mult
rsi_bb_upper = rsi_bb_basis + rsi_bb_dev
rsi_bb_lower = rsi_bb_basis - rsi_bb_dev

// ============================================================================
// MA ON BREADTH (визуализация)
// ============================================================================
ma1_val = f_ma(percentAbove, ma1_len, ma1_type)
ma2_val = f_ma(percentAbove, ma2_len, ma2_type)

// ============================================================================
// ENTRY SIGNALS
// ============================================================================

// --- Фиксированный ---
sig_fix_entry    = ta.crossunder(percentAbove, fix_entry_level)
sig_fix_ema      = trend_enabled and priceBelowTrendMA and percentAbove <= fix_entry_ema

// --- Z-Score ---
sig_z_entry      = ta.crossunder(zscore, zscore_entry_lvl)

// --- BB ---
sig_bb_entry     = ta.crossunder(percentAbove, bb_lower)

// --- Percentile ---
sig_pctl_entry   = ta.crossunder(pctl_rank, pctl_entry_lvl)

// Комбинированный вход
bool long_signal = switch entry_method
    "Фиксированный" => sig_fix_entry or sig_fix_ema
    "Z-Score"        => sig_z_entry
    "BB (Bollinger)" => sig_bb_entry
    "Percentile"     => sig_pctl_entry
    "Все"            => sig_fix_entry or sig_fix_ema or sig_z_entry or sig_bb_entry or sig_pctl_entry
    => sig_fix_entry

// ============================================================================
// EXIT SIGNALS
// ============================================================================

// RSI was above flag
var bool _rsi_was_above = false
if strategy.position_size > 0 and rsi_ma_active >= rsi_exit_level
    _rsi_was_above := true
if strategy.position_size == 0
    _rsi_was_above := false

// --- Фиксированный ---
sig_fix_exit     = ta.crossover(percentAbove, fix_exit_level)

// --- Z-Score ---
sig_z_exit       = ta.crossover(zscore, zscore_exit_lvl)

// --- BB ---
sig_bb_exit      = ta.crossover(percentAbove, bb_upper)

// --- Percentile ---
sig_pctl_exit    = ta.crossover(pctl_rank, pctl_exit_lvl)

// --- RSI (фиксированный) ---
sig_rsi_exit     = rsi_enabled and _rsi_was_above and ta.crossunder(rsi_ma_active, rsi_exit_level)

// --- RSI + BB (динамический) ---
sig_rsi_bb_exit  = rsi_enabled and rsi_bb_enabled and rsi_active > rsi_bb_upper and ta.crossunder(rsi_active, rsi_bb_upper)

// Комбинированный выход
bool exit_signal = switch exit_method
    "Фиксированный" => sig_fix_exit
    "Z-Score"        => sig_z_exit
    "BB (Bollinger)" => sig_bb_exit
    "Percentile"     => sig_pctl_exit
    "RSI"            => sig_rsi_exit
    "RSI + BB"       => sig_rsi_bb_exit
    "Все"            => sig_fix_exit or sig_z_exit or sig_bb_exit or sig_pctl_exit or sig_rsi_exit or sig_rsi_bb_exit
    => sig_fix_exit

// ============================================================================
// EXECUTE STRATEGY
// ============================================================================
if long_signal
    string entry_lbl = switch entry_method
        "Фиксированный" => sig_fix_ema ? "EMA" : "FIX"
        "Z-Score"        => "Z"
        "BB (Bollinger)" => "BB"
        "Percentile"     => "PCT"
        "Все"            => sig_z_entry ? "Z" : sig_bb_entry ? "BB" : sig_pctl_entry ? "PCT" : sig_fix_ema ? "EMA" : "FIX"
        => "?"
    strategy.entry("Long", strategy.long)
    label.new(bar_index, percentAbove, "BUY:" + entry_lbl, style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

if exit_signal and strategy.position_size > 0
    string exit_lbl = switch exit_method
        "Фиксированный" => "FIX"
        "Z-Score"        => "Z"
        "BB (Bollinger)" => "BB"
        "Percentile"     => "PCT"
        "RSI"            => "RSI"
        "RSI + BB"       => "RSI-BB"
        "Все"            => sig_rsi_exit ? "RSI" : sig_rsi_bb_exit ? "RSI-BB" : sig_z_exit ? "Z" : sig_bb_exit ? "BB" : sig_pctl_exit ? "PCT" : "FIX"
        => "?"
    strategy.close_all()
    label.new(bar_index, percentAbove, "SELL:" + exit_lbl, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// ============================================================================
// VISUALIZATION
// ============================================================================
plot_color = percentAbove >= 70 ? color.green : percentAbove >= 50 ? color.new(color.green, 40) : percentAbove >= 30 ? color.new(color.orange, 40) : color.red

plot(percentAbove, "Breadth %", color=plot_color, linewidth=2)
plot(show_histogram ? percentAbove : na, "Гистограмма", color=plot_color, style=plot.style_columns, linewidth=2)

plot(show_ma1 ? ma1_val : na, "MA 1", color=ma1_color, linewidth=2)
plot(show_ma2 ? ma2_val : na, "MA 2", color=ma2_color, linewidth=2)

// BB на breadth
plot(show_bb_overlay ? bb_upper : na, "BB Upper", color=color.new(color.red, 50), linewidth=1, style=plot.style_stepline)
plot(show_bb_overlay ? bb_lower : na, "BB Lower", color=color.new(color.green, 50), linewidth=1, style=plot.style_stepline)
plot(show_bb_overlay ? bb_basis : na, "BB Middle", color=color.new(color.gray, 60), linewidth=1, style=plot.style_stepline)

// Z-Score фон
bgcolor(show_zscore_bg and zscore <= zscore_entry_lvl ? color.new(color.green, 85) : na)
bgcolor(show_zscore_bg and zscore >= zscore_exit_lvl ? color.new(color.red, 85) : na)

// Уровни (фиксированные — если выбран этот метод)
hline(fix_entry_level, "Фикс вход", color.new(color.lime, entry_method == "Фиксированный" or entry_method == "Все" ? 0 : 90), hline.style_dashed, 1)
hline(fix_exit_level, "Фикс выход", color.new(color.red, exit_method == "Фиксированный" or exit_method == "Все" ? 0 : 90), hline.style_dashed, 1)
hline(50, "50%", color.gray, hline.style_solid, 1)

// ============================================================================
// INFO TABLE
// ============================================================================
var table info_table = table.new(position.top_right, 2, 12, bgcolor=color.new(#1e1e1e, 10), border_width=1, border_color=color.new(color.gray, 60))

if barstate.islast
    table.cell(info_table, 0, 0, "Crypto Breadth Lab", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 0, breadth_ma_type + str.tostring(breadth_ma_len) + " [" + breadth_tf + "]", text_color=color.gray, text_size=size.small)

    table.cell(info_table, 0, 1, "Breadth:", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(math.round(countAbove)) + "/" + str.tostring(countTotal) + " = " + str.tostring(math.round(percentAbove, 1)) + "%", text_color=plot_color, text_size=size.small)

    table.cell(info_table, 0, 2, "Z-Score:", text_color=color.gray, text_size=size.small)
    color z_col = zscore <= zscore_entry_lvl ? color.green : zscore >= zscore_exit_lvl ? color.red : color.white
    table.cell(info_table, 1, 2, str.tostring(math.round(zscore, 2)) + "σ", text_color=z_col, text_size=size.small)

    table.cell(info_table, 0, 3, "BB:", text_color=color.gray, text_size=size.small)
    string bb_pos = percentAbove > bb_upper ? "ВЫШЕ ↑" : percentAbove < bb_lower ? "НИЖЕ ↓" : "Внутри"
    color bb_col = percentAbove > bb_upper ? color.red : percentAbove < bb_lower ? color.green : color.white
    table.cell(info_table, 1, 3, str.tostring(math.round(bb_lower, 1)) + " | " + str.tostring(math.round(bb_upper, 1)) + " " + bb_pos, text_color=bb_col, text_size=size.small)

    table.cell(info_table, 0, 4, "Percentile:", text_color=color.gray, text_size=size.small)
    color pctl_col = pctl_rank <= pctl_entry_lvl ? color.green : pctl_rank >= pctl_exit_lvl ? color.red : color.white
    table.cell(info_table, 1, 4, str.tostring(math.round(pctl_rank, 1)) + "%", text_color=pctl_col, text_size=size.small)

    table.cell(info_table, 0, 5, "Тренд " + trend_tf + ":", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 5, trend_enabled ? (priceBelowTrendMA ? "НИЖЕ MA ↓" : "ВЫШЕ MA ↑") : "OFF", text_color=trend_enabled ? (priceBelowTrendMA ? color.red : color.green) : color.gray, text_size=size.small)

    table.cell(info_table, 0, 6, "RSI " + rsi_tf + ":", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 6, rsi_enabled ? str.tostring(math.round(rsi_active, 1)) + " MA:" + str.tostring(math.round(rsi_ma_active, 1)) : "OFF", text_color=rsi_enabled ? (rsi_ma_active >= rsi_exit_level ? color.green : color.red) : color.gray, text_size=size.small)

    if rsi_bb_enabled
        table.cell(info_table, 0, 7, "RSI BB:", text_color=color.gray, text_size=size.small)
        table.cell(info_table, 1, 7, str.tostring(math.round(rsi_bb_lower, 1)) + " | " + str.tostring(math.round(rsi_bb_upper, 1)), text_color=color.aqua, text_size=size.small)
    else
        table.cell(info_table, 0, 7, "RSI BB:", text_color=color.gray, text_size=size.small)
        table.cell(info_table, 1, 7, "OFF", text_color=color.gray, text_size=size.small)

    table.cell(info_table, 0, 8, "—", text_color=color.new(color.gray, 60), text_size=size.small)
    table.cell(info_table, 1, 8, "—", text_color=color.new(color.gray, 60), text_size=size.small)

    table.cell(info_table, 0, 9, "Вход:", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 9, entry_method, text_color=color.lime, text_size=size.small)

    table.cell(info_table, 0, 10, "Выход:", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 10, exit_method, text_color=color.red, text_size=size.small)

    table.cell(info_table, 0, 11, "Источник RSI:", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 11, rsi_source + " [" + rsi_tf + "]", text_color=color.aqua, text_size=size.small)
