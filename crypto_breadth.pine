//@version=6
strategy("Crypto Market Breadth", "CryptoBrth%", overlay=false, max_bars_back=500, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// ============================================================================
// SETTINGS / НАСТРОЙКИ
// ============================================================================
show_histogram = input.bool(true, "Показать гистограмму")
ema_period     = input.int(200, "Период EMA", minval=1, maxval=500)

// Сигналы
entry_level     = input.int(14, "Вход: breadth ≤ %", minval=1, maxval=100, group="Сигналы")
entry_ema_level = input.float(0.75, "Вход: ниже EMA200 и breadth ≤ %", minval=0.1, maxval=100, step=0.25, group="Сигналы")
exit_level      = input.int(60, "Выход: breadth ≥ %", minval=1, maxval=100, group="Сигналы")
rsi_len         = input.int(14, "RSI период", minval=2, maxval=50, group="Выход RSI")
rsi_ma_len      = input.int(14, "SMA на RSI", minval=2, maxval=50, group="Выход RSI")
rsi_exit_level  = input.int(70, "RSI выход <", minval=30, maxval=90, group="Выход RSI")

// MA на индикатор
show_ma1   = input.bool(true,  "MA 1")
ma1_type   = input.string("SMA", "  Тип", options=["SMA", "EMA"], group="MA 1")
ma1_len    = input.int(10, "  Длина", minval=1, maxval=200, group="MA 1")
ma1_color  = input.color(color.yellow, "  Цвет", group="MA 1")

show_ma2   = input.bool(false, "MA 2")
ma2_type   = input.string("SMA", "  Тип", options=["SMA", "EMA"], group="MA 2")
ma2_len    = input.int(30, "  Длина", minval=1, maxval=200, group="MA 2")
ma2_color  = input.color(color.white, "  Цвет", group="MA 2")

show_ma3   = input.bool(false, "MA 3")
ma3_type   = input.string("EMA", "  Тип", options=["SMA", "EMA"], group="MA 3")
ma3_len    = input.int(50, "  Длина", minval=1, maxval=200, group="MA 3")
ma3_color  = input.color(color.aqua, "  Цвет", group="MA 3")

// ============================================================================
// TOP 30 CRYPTO BY MARKET CAP / ТОП 30 КРИПТОВАЛЮТ
// ============================================================================
tickers = array.from(
     "BINANCE:BTCUSDT",   "BINANCE:ETHUSDT",    "BINANCE:XRPUSDT",
     "BINANCE:BNBUSDT",   "BINANCE:SOLUSDT",    "BINANCE:DOGEUSDT",
     "BINANCE:ADAUSDT",   "BINANCE:TRXUSDT",    "BINANCE:AVAXUSDT",
     "BINANCE:LINKUSDT",  "BINANCE:TONUSDT",    "BINANCE:SHIBUSDT",
     "BINANCE:XLMUSDT",   "BINANCE:DOTUSDT",    "BINANCE:SUIUSDT",
     "BINANCE:HBARUSDT",  "BINANCE:BCHUSDT",    "BINANCE:LTCUSDT",
     "BINANCE:UNIUSDT",   "BINANCE:NEARUSDT",   "BINANCE:APTUSDT",
     "BINANCE:PEPEUSDT",  "BINANCE:ICPUSDT",    "BINANCE:POLUSDT",
     "BINANCE:ETCUSDT",   "BINANCE:RENDERUSDT", "BINANCE:FETUSDT",
     "BINANCE:ATOMUSDT",  "BINANCE:FILUSDT",    "BINANCE:ARBUSDT")

// ============================================================================
// BREADTH / РАСЧЕТ (Weekly EMA на дневном графике)
// ============================================================================
f_getEMAcondition(symbol, period) =>
    [price, ema_val] = request.security(symbol, "W", [close, ta.ema(close, period)], barmerge.gaps_off)
    price > ema_val and not na(price) and not na(ema_val)

countAbove = 0
for i = 0 to array.size(tickers) - 1
    if f_getEMAcondition(array.get(tickers, i), ema_period)
        countAbove := countAbove + 1

countTotal   = array.size(tickers)
percentAbove = (countAbove / countTotal) * 100

// ============================================================================
// WEEKLY EMA200 цены графика (для условия входа)
// ============================================================================
[chartClose_w, chartEma200_w] = request.security(syminfo.tickerid, "W", [close, ta.ema(close, 200)], barmerge.gaps_off)
priceBelowEMA200 = not na(chartClose_w) and not na(chartEma200_w) and chartClose_w < chartEma200_w

// ============================================================================
// WEEKLY RSI для выхода (как в трендевушке)
// ============================================================================
[rsi_w, rsiMa_w] = request.security(syminfo.tickerid, "W", [ta.rsi(close, rsi_len), ta.sma(ta.rsi(close, rsi_len), rsi_ma_len)], barmerge.gaps_off)

// ============================================================================
// MA ON INDICATOR / СКОЛЬЗЯЩИЕ НА ИНДИКАТОРЕ
// ============================================================================
f_ma(src, len, typ) => typ == "EMA" ? ta.ema(src, len) : ta.sma(src, len)

ma1_val = f_ma(percentAbove, ma1_len, ma1_type)
ma2_val = f_ma(percentAbove, ma2_len, ma2_type)
ma3_val = f_ma(percentAbove, ma3_len, ma3_type)

// ============================================================================
// STRATEGY / СДЕЛКИ
// ============================================================================

// --- ВХОДЫ (любой из двух) ---
// 1. Breadth пересёк entry_level вниз
entry1 = ta.crossunder(percentAbove, entry_level)

// 2. Цена ниже Weekly EMA200 и breadth пересёк 0.75% вниз
entry2 = priceBelowEMA200 and ta.crossunder(percentAbove, entry_ema_level)

if entry1 or entry2
    strategy.entry("Long", strategy.long)

// --- ВЫХОДЫ (первый ИЛИ второй) ---
// 1. Breadth пересёк exit_level вверх
exit1 = ta.crossover(percentAbove, exit_level)

// 2. Weekly SMA(RSI) пересёк rsi_exit_level вниз (из трендевушки)
exit2 = ta.crossunder(rsiMa_w, rsi_exit_level)

if (exit1 or exit2) and strategy.position_size > 0
    strategy.close("Long")

// ============================================================================
// COLOR LOGIC / ЛОГИКА ЦВЕТОВ
// ============================================================================
plot_color = percentAbove >= 70 ? color.green : percentAbove >= 50 ? color.new(color.green, 40) : percentAbove >= 30 ? color.new(color.orange, 40) : color.red

// ============================================================================
// VISUALIZATION / ВИЗУАЛИЗАЦИЯ
// ============================================================================
plot(percentAbove, "Breadth %", color=plot_color, linewidth=2, style=plot.style_line)
plot(show_histogram ? percentAbove : na, "Гистограмма", color=plot_color, style=plot.style_columns, linewidth=2)

plot(show_ma1 ? ma1_val : na, "MA 1", color=ma1_color, linewidth=2)
plot(show_ma2 ? ma2_val : na, "MA 2", color=ma2_color, linewidth=2)
plot(show_ma3 ? ma3_val : na, "MA 3", color=ma3_color, linewidth=2)

hline(entry_level, "Вход", color.lime, hline.style_dashed, 1)
hline(exit_level,  "Выход", color.red, hline.style_dashed, 1)
hline(50, "50%", color.gray, hline.style_solid, 1)

// ============================================================================
// INFO TABLE
// ============================================================================
var table info_table = table.new(position.top_right, 2, 5, bgcolor=color.new(color.white, 20), border_width=1)

if barstate.islast
    table.cell(info_table, 0, 0, "Breadth (W EMA" + str.tostring(ema_period) + "):", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 0, str.tostring(math.round(countAbove)) + " / " + str.tostring(countTotal), text_color=color.white, text_size=size.small)
    table.cell(info_table, 0, 1, "Процент:", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(math.round(percentAbove, 1)) + "%", text_color=plot_color, text_size=size.small)
    table.cell(info_table, 0, 2, "Ниже W EMA200:", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 2, priceBelowEMA200 ? "Да" : "Нет", text_color=priceBelowEMA200 ? color.red : color.green, text_size=size.small)
    table.cell(info_table, 0, 3, "W RSI SMA:", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 3, str.tostring(math.round(rsiMa_w, 1)), text_color=rsiMa_w >= rsi_exit_level ? color.green : color.red, text_size=size.small)
    table.cell(info_table, 0, 4, "Вход/Выход:", text_color=color.gray, text_size=size.small)
    table.cell(info_table, 1, 4, str.tostring(entry_level) + "% / " + str.tostring(exit_level) + "%", text_color=color.white, text_size=size.small)
