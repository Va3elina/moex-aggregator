# ═══════════════════════════════════════════════════════════════════════════════
#  Фрейм — пример .env (скопируй в .env и заполни значения)
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Этот файл НЕ содержит реальных секретов — только список нужных переменных
#  и формат. Сам .env и .env.production добавлены в .gitignore.


# ─── База данных (PostgreSQL) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=frame
DB_USER=frame
DB_PASSWORD=
DB_URL=postgresql+pg8000://frame:PASSWORD@localhost:5432/frame
DB_URL_ASYNC=postgresql+asyncpg://frame:PASSWORD@localhost:5432/frame


# ─── API ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
ENV=development          # 'development' или 'production'


# ─── Auth (JWT) ─────────────────────────────────────────────────────────
# Сгенерируй командой: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=


# ─── Внешние API ────────────────────────────────────────────────────────
ALGOPACK_API_KEY=        # для OI и candles (запрос в поддержке MOEX Algopack)


# ─── OAuth провайдеры (опционально, для логина через Google/VK/Yandex) ──
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://example.com/auth/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://example.com/auth/callback


# ─── Telegram Bot (для уведомлений админу) ─────────────────────────────
BOT_TOKEN=
ADMIN_CHAT_ID=


# ─── Cbonds (для данных по фондам) ──────────────────────────────────────
CBONDS_LOGIN=
CBONDS_PASSWORD=


# ═══════════════════════════════════════════════════════════════════════════════
#  BILLING — ЮKassa (платёжная система)
# ═══════════════════════════════════════════════════════════════════════════════
#
#  КАК ПОЛУЧИТЬ:
#  1. Зарегистрироваться на https://yookassa.ru (нужен ИП или ООО)
#  2. Пройти верификацию (1-3 рабочих дня, проверка документов)
#  3. В личном кабинете: Настройки → Магазин → Ключи API
#     Скопировать SHOP_ID и SECRET_KEY — вставить сюда.
#  4. В разделе "Уведомления HTTP" добавить URL:
#     https://xn--80aklbnczmv.xn--p1ai/api/billing/webhook
#     События: payment.succeeded, payment.canceled, refund.succeeded
#
#  ПОКА ПЕРЕМЕННЫЕ ПУСТЫЕ → работает заглушка (Stub-провайдер):
#  все платежи имитируются, реальных списаний нет. Можно тестировать
#  логику подписок, миграции, UI без реальных ключей.
#
YOOKASSA_SHOP_ID=            # число, например 123456
YOOKASSA_SECRET_KEY=         # строка вида live_xxxxxxxxxxxxxxxxxxxxx (или test_...)
