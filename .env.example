# ═══════════════════════════════════════════════════════════════════════════════
#  Фрейм — пример .env (скопируй в .env и заполни значения)
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Этот файл НЕ содержит реальных секретов — только список нужных переменных
#  и формат. Сам .env и .env.production добавлены в .gitignore.


# ─── База данных (PostgreSQL) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=frame
DB_USER=frame
DB_PASSWORD=
DB_URL=postgresql+pg8000://frame:PASSWORD@localhost:5432/frame
DB_URL_ASYNC=postgresql+asyncpg://frame:PASSWORD@localhost:5432/frame


# ─── API ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
ENV=development          # 'development' или 'production'


# ─── Auth (JWT) ─────────────────────────────────────────────────────────
# Сгенерируй командой: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=


# ─── Внешние API ────────────────────────────────────────────────────────
ALGOPACK_API_KEY=        # для OI и candles (запрос в поддержке MOEX Algopack)


# ─── OAuth провайдеры (опционально, для логина через Google/VK/Yandex) ──
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://example.com/auth/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://example.com/auth/callback


# ─── Telegram Bot (для уведомлений админу) ─────────────────────────────
BOT_TOKEN=
ADMIN_CHAT_ID=

# ─── Kill-switch: сигналы аномальных потоков фондов ────────────────────
#  0 — выключает и персональные fund-алерты (Telegram/site/email), и
#  публичную ленту тостов по фондам. Подписки не трогаются: снял флаг —
#  рассылка продолжилась сама. OI-сигналы и уведомление «вышли новые
#  данные по фондам» не затрагиваются. Пусто/не задано = включено.
FUNDS_FLOW_ALERTS_ENABLED=1


# ─── Cbonds (для данных по фондам) ──────────────────────────────────────
CBONDS_LOGIN=
CBONDS_PASSWORD=


# ═══════════════════════════════════════════════════════════════════════════════
#  BILLING — T-Bank (единственный провайдер с 2026-05-13)
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Factory:
#    1. T-Bank — если заданы TBANK_TERMINAL_KEY + TBANK_PASSWORD
#    2. Stub   — иначе (для dev / pre-onboarding, платежи fake)
#
#  YooKassa удалена. Если когда-то понадобится — есть в git history.
#
# ─── T-Bank Acquiring ──────────────────────────────────────────────────
#
#  КАК ПОЛУЧИТЬ:
#  1. Войти на https://www.tbank.ru/business/ (нужен ИП или ООО + расчётный счёт)
#  2. Подключить "Интернет-эквайринг" в личном кабинете
#  3. Получить TerminalKey + Password от терминала
#  4. В кабинете терминала: Уведомления → URL для нотификаций:
#     https://xn--80aklbnczmv.xn--p1ai/api/billing/webhook
#     События: успех/отмена/возврат (все, см. документацию)
#  5. Если у ИП нет онлайн-кассы, в кабинете указать "Не использую онлайн-кассу"
#     → T-Bank сам передаёт чеки в ОФД (54-ФЗ compliance)
#
#  DEMO terminal (для тестов без подключённого ИП):
#    TBANK_TERMINAL_KEY=1778520522278DEMO
#    TBANK_PASSWORD=JDGWYBbWWGhrJMDK
#  Тестовые карты:
#    2200 7702 0586 4830 — обычная оплата
#    4000 0000 0000 0333 — для регистрации рекуррента (Recurrent=Y)
#    4000 0000 0000 0101 — успешная оплата + чек 54-ФЗ
#    5000 0000 0000 0108 — оплата + возврат + чек возврата
#
TBANK_TERMINAL_KEY=          # 1778520522278DEMO для тестов, или production-ключ
TBANK_PASSWORD=              # JDGWYBbWWGhrJMDK для тестов, или production-пароль

# ─── Демо-терминал для НОВЫХ пользователей ─────────────────────────────
#
#  Пока приём денег не запущен: новые юзеры видят настоящую форму T-Bank,
#  вводят карту, но подписку не получают (возврат на /billing/unavailable
#  с текстом «оплата временно недоступна»). Триал им тоже закрыт.
#  Старые платящие не затронуты: их checkout и авто-продление идут на боевом
#  терминале (роутинг продлений — по payment_methods.provider='tbank').
#
#  Включается ОБЕИМИ переменными сразу; пустые → фича спит.
#  Webhook демо-терминала в кабинете T-Bank регистрировать НЕ нужно.
TBANK_DEMO_TERMINAL_KEY=     # 1778520522278DEMO
TBANK_DEMO_PASSWORD=         # JDGWYBbWWGhrJMDK
BILLING_DEMO_SINCE=          # 2026-08-24 — с этой даты регистрации юзер считается новым

# Receipt 54-ФЗ — фискализация через T-Bank → ОФД
TBANK_RECEIPT_ENABLED=       # 1 = включить, пусто/0 = выключить
TBANK_TAXATION=usn_income    # osn / usn_income / usn_income_outcome / envd / esn / patent
TBANK_VAT=none               # none (УСН) / vat0 / vat10 / vat20 (для ОСН)


# ═══════════════════════════════════════════════════════════════════════════════
#  ПОЧТА — SMTP Yandex 360 (письма-подтверждения email при регистрации)
# ═══════════════════════════════════════════════════════════════════════════════
#
#  КАК ПОЛУЧИТЬ:
#  1. Yandex 360 для бизнеса → подключить домен таймфрейм.рф, добавить в Reg.ru
#     DNS-записи MX (mx.yandex.net.), SPF (v=spf1 redirect=_spf.yandex.net),
#     DKIM (mail._domainkey). Делегировать домен НЕ нужно.
#  2. Создать ящик-сотрудника noreply (→ noreply@таймфрейм.рф).
#  3. Войти в ящик → включить «Почтовые программы» (IMAP + пароли приложений).
#  4. Yandex ID → Безопасность → Пароли приложений → тип «Почта» → создать.
#     Пароль начинает работать через 2-3 часа после создания.
#
#  ВАЖНО: SMTP_USER/SMTP_FROM — в PUNYCODE (домен таймфрейм.рф = xn--80aklbnczmv.xn--p1ai),
#  потому что SMTP AUTH и заголовок From — ASCII-протокол.
#
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465                                    # SSL
SMTP_USER=noreply@xn--80aklbnczmv.xn--p1ai       # punycode таймфрейм.рф!
SMTP_PASSWORD=                                    # пароль приложения Yandex ID (16 символов)
SMTP_FROM=noreply@xn--80aklbnczmv.xn--p1ai       # обычно = SMTP_USER
SMTP_FROM_NAME=Фрейм                              # display-name отправителя


# ─── KILL-SWITCH: публичный API + CSV-экспорт ──────────────────────────────
#  Скрыто до официального запуска (конкуренты). Пусто = выключено:
#  роутеры /api/export, /api/keys, /api/v1/public НЕ монтируются (404),
#  csv_export/api_access=False даже для Pro, UI скрыт.
#  Включить на запуске: PUBLIC_API_CSV_ENABLED=1 ЗДЕСЬ + фронт
#  frontend/src/config/features.ts → API_CSV_ENABLED=true + rebuild.
PUBLIC_API_CSV_ENABLED=

# ─── Redis (defense-in-depth, аудит 2026-06-10) ────────────────────────────
#  requirepass для Redis — обязателен. Redis не торчит наружу (только docker-
#  сеть), но без пароля любой контейнер имел бы полный доступ к кэшу. Значение
#  подставляется в docker-compose (redis command + healthcheck + api REDIS_URL).
#  Сгенерировать: openssl rand -hex 24
REDIS_PASSWORD=

# ─── API-документация (Swagger/ReDoc) ──────────────────────────────────────
#  Выключены по умолчанию (на проде не должны быть доступны анонимно — это
#  карта всех эндпоинтов для разведки). Для локальной разработки: ENABLE_API_DOCS=1
#  → /api/docs, /api/redoc, /api/openapi.json. На проде НЕ задавать.
ENABLE_API_DOCS=

# ─── Еженедельный Routine-скаут вынужденных потоков (frame-mandate-scan) ───
#  api/routers/mandate_scan.py — shared secret для server-to-server callback,
#  отдельный от CONTENT_AI_INTERNAL_TOKEN (свой домен, свой blast radius).
#  Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
MANDATE_SCAN_INTERNAL_TOKEN=
#  Уведомление о найденных кандидатах в @frameadminbot — те же credentials,
#  что у tg_bot-сервиса ниже (BOT_TOKEN/ADMIN_CHAT_ID), нужны ещё и в api-контейнере.
#  См. tg_bot-секцию этого файла (если есть) или docker-compose.yml BOT_TOKEN/ADMIN_CHAT_ID.
