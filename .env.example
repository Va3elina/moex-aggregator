# ═══════════════════════════════════════════════════════════════════════════════
#  Фрейм — пример .env (скопируй в .env и заполни значения)
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Этот файл НЕ содержит реальных секретов — только список нужных переменных
#  и формат. Сам .env и .env.production добавлены в .gitignore.


# ─── База данных (PostgreSQL) ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=frame
DB_USER=frame
DB_PASSWORD=
DB_URL=postgresql+pg8000://frame:PASSWORD@localhost:5432/frame
DB_URL_ASYNC=postgresql+asyncpg://frame:PASSWORD@localhost:5432/frame


# ─── API ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
ENV=development          # 'development' или 'production'


# ─── Auth (JWT) ─────────────────────────────────────────────────────────
# Сгенерируй командой: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=


# ─── Внешние API ────────────────────────────────────────────────────────
ALGOPACK_API_KEY=        # для OI и candles (запрос в поддержке MOEX Algopack)


# ─── OAuth провайдеры (опционально, для логина через Google/VK/Yandex) ──
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://example.com/auth/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://example.com/auth/callback


# ─── Telegram Bot (для уведомлений админу) ─────────────────────────────
BOT_TOKEN=
ADMIN_CHAT_ID=


# ─── Cbonds (для данных по фондам) ──────────────────────────────────────
CBONDS_LOGIN=
CBONDS_PASSWORD=


# ═══════════════════════════════════════════════════════════════════════════════
#  BILLING — приоритет: T-Bank → YooKassa (legacy) → Stub
# ═══════════════════════════════════════════════════════════════════════════════
#
#  Factory выбирает провайдера по env:
#    1. T-Bank          — если заданы TBANK_TERMINAL_KEY + TBANK_PASSWORD
#    2. YooKassa        — если заданы YOOKASSA_SHOP_ID + YOOKASSA_SECRET_KEY
#    3. Stub (заглушка) — если ничего не задано (для dev / pre-onboarding)
#
# ─── T-Bank Acquiring (основной провайдер с 2026) ──────────────────────
#
#  КАК ПОЛУЧИТЬ:
#  1. Войти на https://www.tbank.ru/business/ (нужен ИП или ООО + расчётный счёт)
#  2. Подключить "Интернет-эквайринг" в личном кабинете
#  3. Получить TerminalKey + Password от терминала
#  4. В кабинете терминала: Уведомления → URL для нотификаций:
#     https://xn--80aklbnczmv.xn--p1ai/api/billing/webhook
#     События: успех/отмена/возврат (все, см. документацию)
#  5. Если у ИП нет онлайн-кассы, в кабинете указать "Не использую онлайн-кассу"
#     → T-Bank сам передаёт чеки в ОФД (54-ФЗ compliance)
#
#  DEMO terminal (для тестов без подключённого ИП):
#    TBANK_TERMINAL_KEY=1778520522278DEMO
#    TBANK_PASSWORD=JDGWYBbWWGhrJMDK
#  Тестовая карта: 2200 7702 0586 4830  любой CVV  12/30
#
TBANK_TERMINAL_KEY=          # 1778520522278DEMO для тестов, или production-ключ
TBANK_PASSWORD=              # JDGWYBbWWGhrJMDK для тестов, или production-пароль

# ─── ЮKassa (legacy fallback, на случай если T-Bank отказал) ────────────
#
#  Если у вас уже подключена ЮKassa и нужно переключаться обратно — задайте
#  обе переменные ниже + удалите/закомментируйте TBANK_* выше.
#  В большинстве случаев оставьте пустыми (factory выберет T-Bank автоматически).
#
YOOKASSA_SHOP_ID=            # число, например 123456 (только если используете ЮKassa)
YOOKASSA_SECRET_KEY=         # live_xxx или test_xxx (только если используете ЮKassa)
