//@version=6
// ──────────────────────────────────────────────────────────────────────────────
//  Годовая сезонность (YTD %) — повторение графика Frame / таймфрейм.рф
// ──────────────────────────────────────────────────────────────────────────────
//  Применять на дневном таймфрейме (1D). На IMOEX в TV достаточно истории
//  с 1997 г. — можно выбирать since_year от 2000 и выше.
//
//  Методика (идентична /api/seasonality/yearly в бэкенде Frame):
//  1. Для каждого календарного года считаем кумулятивное изменение цены
//     относительно первого close года: pct_i = (close_i / first_close_year - 1) * 100.
//  2. Для каждого торгового дня №N от начала года (td_idx) усредняем pct
//     по всем историческим годам (кроме текущего).
//  3. Рисуем две линии на барах текущего года:
//     - серая: среднее по годам ≥ since_year
//     - оранжевая: фактический YTD текущего года
// ──────────────────────────────────────────────────────────────────────────────
indicator("Годовая сезонность (YTD %)", shorttitle="YearSeason",
          overlay=false, precision=2, format=format.percent)

sinceYear      = input.int(2000, "Начиная с года", minval=1990, maxval=2025)
excludeCurrent = input.bool(true, "Исключать текущий год из среднего")
avgColor       = input.color(color.gray,   "Цвет средней линии")
curColor       = input.color(color.orange, "Цвет текущего года")

// ── Состояние ────────────────────────────────────────────────────────────────
// map<год, массив pct>: для каждого календарного года храним кумулятивную
// YTD-траекторию по торговым дням (индекс = td_idx-1).
var map<int, array<float>> yrs = map.new<int, array<float>>()
var int   tdIdx      = 0    // порядковый номер торгового дня в текущем году
var float firstClose = na   // close первого торгового дня текущего года

bYear = year(time)

// Сброс на старте нового года
newYear = ta.change(bYear) != 0
if newYear or barstate.isfirst
    tdIdx      := 0
    firstClose := close

tdIdx += 1

pct = firstClose > 0 ? (close - firstClose) / firstClose * 100.0 : na

// Накапливаем данные в карту
if bYear >= sinceYear and not na(pct)
    if not map.contains(yrs, bYear)
        map.put(yrs, bYear, array.new<float>())
    arr = map.get(yrs, bYear)
    array.push(arr, pct)

// ── Вычисление средней и текущей линий только на барах текущего года ─────────
curYear   = year(last_bar_time)
isCurYear = bYear == curYear

float avg = na
if isCurYear
    float s = 0.0
    int   n = 0
    keys = map.keys(yrs)
    for y in keys
        if y >= sinceYear and (not excludeCurrent or y != curYear)
            a = map.get(yrs, y)
            if array.size(a) >= tdIdx
                s += array.get(a, tdIdx - 1)
                n += 1
    avg := n > 0 ? s / n : na

curPct = isCurYear ? pct : na

// ── Отрисовка ────────────────────────────────────────────────────────────────
plot(avg,    "Среднее по годам", color=avgColor, linewidth=2)
plot(curPct, "Текущий год",      color=curColor, linewidth=2)
hline(0, "Ноль", color=color.new(color.gray, 50), linestyle=hline.style_dashed)
