//@version=6
strategy("Crypto Breadth v2", "CrBrth2", overlay=false, max_bars_back=500, pyramiding=2, default_qty_type=strategy.percent_of_equity, default_qty_value=50)

// ============================================================================
// 1. BREADTH
// ============================================================================
breadth_ma_type = input.string("EMA", "MA тип", options=["EMA", "SMA", "WMA", "RMA"], group="Breadth")
breadth_ma_len  = input.int(200, "MA период", minval=1, maxval=500, group="Breadth")
breadth_tf      = input.timeframe("D", "Таймфрейм", group="Breadth")
entry_level     = input.int(14, "Вход: breadth ≤ %", minval=1, maxval=100, group="Breadth")

// ============================================================================
// 2. ТРЕНД (EMA на цене)
// ============================================================================
trend_ma_type = input.string("EMA", "MA тип", options=["EMA", "SMA", "WMA", "RMA"], group="Тренд")
trend_ma_len  = input.int(200, "MA период", minval=1, maxval=500, group="Тренд")
trend_tf      = input.timeframe("W", "Таймфрейм", group="Тренд")
entry_ema_lvl = input.float(0.75, "Вход: ниже MA + breadth ≤ %", minval=0.1, maxval=100, step=0.25, group="Тренд")

// ============================================================================
// 3. RSI (выход)
// ============================================================================
rsi_len        = input.int(14, "RSI период", minval=2, maxval=50, group="RSI")
rsi_ma_type    = input.string("SMA", "RSI MA тип", options=["SMA", "EMA", "WMA", "RMA"], group="RSI")
rsi_ma_len     = input.int(14, "RSI MA период", minval=2, maxval=50, group="RSI")
rsi_tf         = input.timeframe("W", "Таймфрейм", group="RSI")
rsi_exit_level = input.int(70, "Выход: RSI MA <", minval=30, maxval=90, group="RSI")

// ============================================================================
// 4. ВИЗУАЛИЗАЦИЯ
// ============================================================================
show_histogram = input.bool(true, "Гистограмма", group="Вид")
show_ma        = input.bool(true, "MA на breadth", group="Вид")
ma_type        = input.string("SMA", "  Тип", options=["SMA", "EMA", "WMA", "RMA"], group="Вид")
ma_len         = input.int(10, "  Длина", minval=1, maxval=200, group="Вид")

// ============================================================================
// CRYPTO TOP 30
// ============================================================================
tickers = array.from(
     "BINANCE:BTCUSDT",   "BINANCE:ETHUSDT",    "BINANCE:XRPUSDT",
     "BINANCE:BNBUSDT",   "BINANCE:SOLUSDT",    "BINANCE:DOGEUSDT",
     "BINANCE:ADAUSDT",   "BINANCE:TRXUSDT",    "BINANCE:AVAXUSDT",
     "BINANCE:LINKUSDT",  "BINANCE:TONUSDT",    "BINANCE:SHIBUSDT",
     "BINANCE:XLMUSDT",   "BINANCE:DOTUSDT",    "BINANCE:SUIUSDT",
     "BINANCE:HBARUSDT",  "BINANCE:BCHUSDT",    "BINANCE:LTCUSDT",
     "BINANCE:UNIUSDT",   "BINANCE:NEARUSDT",   "BINANCE:APTUSDT",
     "BINANCE:PEPEUSDT",  "BINANCE:ICPUSDT",    "BINANCE:POLUSDT",
     "BINANCE:ETCUSDT",   "BINANCE:RENDERUSDT", "BINANCE:FETUSDT",
     "BINANCE:ATOMUSDT",  "BINANCE:FILUSDT",    "BINANCE:ARBUSDT")

// ============================================================================
// HELPERS
// ============================================================================
f_ma(src, len, typ) =>
    switch typ
        "EMA" => ta.ema(src, len)
        "SMA" => ta.sma(src, len)
        "WMA" => ta.wma(src, len)
        "RMA" => ta.rma(src, len)
        => ta.sma(src, len)

// ============================================================================
// BREADTH
// ============================================================================
f_cond(symbol, ma_period, ma_typ) =>
    switch ma_typ
        "EMA" =>
            [p, m] = request.security(symbol, breadth_tf, [close, ta.ema(close, ma_period)], barmerge.gaps_on)
            p > m and not na(p) and not na(m)
        "SMA" =>
            [p, m] = request.security(symbol, breadth_tf, [close, ta.sma(close, ma_period)], barmerge.gaps_on)
            p > m and not na(p) and not na(m)
        "WMA" =>
            [p, m] = request.security(symbol, breadth_tf, [close, ta.wma(close, ma_period)], barmerge.gaps_on)
            p > m and not na(p) and not na(m)
        "RMA" =>
            [p, m] = request.security(symbol, breadth_tf, [close, ta.rma(close, ma_period)], barmerge.gaps_on)
            p > m and not na(p) and not na(m)
        =>
            [p, m] = request.security(symbol, breadth_tf, [close, ta.ema(close, ma_period)], barmerge.gaps_on)
            p > m and not na(p) and not na(m)

countAbove = 0
for i = 0 to array.size(tickers) - 1
    if f_cond(array.get(tickers, i), breadth_ma_len, breadth_ma_type)
        countAbove := countAbove + 1

countTotal   = array.size(tickers)
percentAbove = (countAbove / countTotal) * 100

// ============================================================================
// TREND MA
// ============================================================================
[chartClose_t, chartMA_t] = request.security(syminfo.tickerid, trend_tf, [close, f_ma(close, trend_ma_len, trend_ma_type)], barmerge.gaps_on)
priceBelowMA = chartClose_t < chartMA_t and not na(chartClose_t) and not na(chartMA_t)

// ============================================================================
// RSI
// ============================================================================
[rsi_w, rsiMa_w] = request.security(syminfo.tickerid, rsi_tf, [ta.rsi(close, rsi_len), f_ma(ta.rsi(close, rsi_len), rsi_ma_len, rsi_ma_type)])

// ============================================================================
// STRATEGY
// ============================================================================

// --- ВХОДЫ ---
entry1 = ta.crossunder(percentAbove, entry_level)
entry2 = priceBelowMA and percentAbove <= entry_ema_lvl

if entry1
    strategy.entry("Long Breadth", strategy.long)
    label.new(bar_index, percentAbove, "BUY: breadth≤" + str.tostring(entry_level) + "%", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

if entry2
    strategy.entry("Long EMA", strategy.long)
    label.new(bar_index, percentAbove, "BUY: MA+" + str.tostring(entry_ema_lvl) + "%", style=label.style_label_up, color=color.purple, textcolor=color.white, size=size.small)

// --- ВЫХОД (только RSI) ---
var bool _rsi_was_above = false
if strategy.position_size > 0 and rsiMa_w >= rsi_exit_level
    _rsi_was_above := true
if strategy.position_size == 0
    _rsi_was_above := false

exit_rsi = _rsi_was_above and ta.crossunder(rsiMa_w, rsi_exit_level)

if exit_rsi and strategy.position_size > 0
    strategy.close_all()
    label.new(bar_index, percentAbove, "SELL: RSI<" + str.tostring(rsi_exit_level), style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.small)

// ============================================================================
// VISUALIZATION
// ============================================================================
plot_color = percentAbove >= 70 ? color.green : percentAbove >= 50 ? color.new(color.green, 40) : percentAbove >= 30 ? color.new(color.orange, 40) : color.red

plot(percentAbove, "Breadth %", color=plot_color, linewidth=2)
plot(show_histogram ? percentAbove : na, "Гистограмма", color=plot_color, style=plot.style_columns, linewidth=2)

ma_val = f_ma(percentAbove, ma_len, ma_type)
plot(show_ma ? ma_val : na, "MA", color=color.yellow, linewidth=2)

hline(entry_level, "Вход", color.lime, hline.style_dashed, 1)
hline(50, "50%", color.gray, hline.style_solid, 1)

// ============================================================================
// TABLE
// ============================================================================
var table info = table.new(position.top_right, 2, 7, bgcolor=color.new(#1e1e1e, 10), border_width=1, border_color=color.new(color.gray, 60))

if barstate.islast
    table.cell(info, 0, 0, "Breadth [" + breadth_tf + "]:", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 0, str.tostring(math.round(countAbove)) + "/" + str.tostring(countTotal) + " = " + str.tostring(math.round(percentAbove, 1)) + "%", text_color=plot_color, text_size=size.small)
    table.cell(info, 0, 1, breadth_ma_type + str.tostring(breadth_ma_len) + ":", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 1, "выше = " + str.tostring(math.round(percentAbove, 1)) + "%", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 2, "Тренд [" + trend_tf + "]:", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 2, priceBelowMA ? "НИЖЕ " + trend_ma_type + str.tostring(trend_ma_len) : "ВЫШЕ " + trend_ma_type + str.tostring(trend_ma_len), text_color=priceBelowMA ? color.red : color.green, text_size=size.small)
    table.cell(info, 0, 3, "RSI [" + rsi_tf + "]:", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 3, str.tostring(math.round(rsiMa_w, 1)), text_color=rsiMa_w >= rsi_exit_level ? color.green : color.red, text_size=size.small)
    table.cell(info, 0, 4, "RSI was ≥" + str.tostring(rsi_exit_level) + ":", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 4, _rsi_was_above ? "ДА ✓" : "НЕТ", text_color=_rsi_was_above ? color.green : color.red, text_size=size.small)
    table.cell(info, 0, 5, "Вход:", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 5, "≤" + str.tostring(entry_level) + "% | MA+" + str.tostring(entry_ema_lvl) + "%", text_color=color.lime, text_size=size.small)
    table.cell(info, 0, 6, "Выход:", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 6, "RSI<" + str.tostring(rsi_exit_level), text_color=color.orange, text_size=size.small)
